    "lens.hidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨은 것"
          }
        }
      }
    },
    "lens.hidden.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chests, ghost-stone rooms, water veils and thrones show. Blue light sees further."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상자, 유령 돌의 방, 물의 장막, 왕좌가 보인다. 푸른빛이면 더 멀리 보인다."
          }
        }
      }
    },
    "lens.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lens off. A lens burns light while it is on."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈를 껐다. 렌즈는 켜 두는 동안 빛을 쓴다."
          }
        }
      }
    },
    "lens.ore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ore"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광물"
          }
        }
      }
    },
    "lens.ore.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ores glint through rock. Red light sees further and shows hidden veins."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광석이 바위 너머로 반짝인다. 붉은빛이면 더 멀리 보이고 숨은 광맥까지 보인다."
          }
        }
      }
    },
    "lens.path": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길"
          }
        }
      }
    },
    "lens.path.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cracked veins, junctions and light springs show through rock; with none near, an arrow points the way down. Green light sees further."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갈라진 길, 갈림길, 빛샘이 바위 너머로 보인다. 근처에 없으면 아래로 가는 길을 화살표가 가리킨다. 초록빛이면 더 멀리 보인다."
          }
        }
      }
    },
    "lens.switched": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jar lens: %1$@ — %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병의 렌즈: %1$@ — %2$@"
          }
        }
      }
    },
    "lord.5.challenger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People tired of waiting have come. This time they will not wait for tomorrow."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다리다 지친 사람들이 왔다. 이번에는 내일까지 기다리지 않겠다고 한다."
          }
        }
      }
    },
    "lord.5.creed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Not yet. The wind is cold today. Tomorrow we plant. Tomorrow can’t be worse than today.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“아직 아니다. 오늘은 바람이 차다. 내일 심자. 내일이 오늘보다 나쁠 리 없으니까.”"
          }
        }
      }
    },
    "lord.5.last": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Open the bottom drawer. There is one seed in it marked ‘today’. That one… plant it for me.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“맨 아래 서랍을 열어 봐라. ‘오늘’이라고 적힌 씨앗이 하나 있다. 그건… 네가 심어 다오.”"
          }
        }
      }
    },
    "lord.5.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the Keeper of Tomorrow"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일을 지키는 사람"
          }
        }
      }
    },
    "lord.5.plea": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“If you open the drawers, the seeds will all spill out. Then everything would grow today. And what would be left for tomorrow?”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“서랍을 열면 씨앗이 다 쏟아진다. 그러면 전부 오늘 자라 버리겠지. 그럼 내일엔 무엇이 남니?”"
          }
        }
      }
    },
    "lord.5.rumor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up above, the grown-ups say the lord of floor 5 stole every seed in the forest and locked them in drawers. That is why the forest never grows."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 어른들은 5층 주인이 숲의 씨앗을 모두 훔쳐 서랍에 가뒀다고 한다. 그래서 숲이 자라지 않는다고."
          }
        }
      }
    },
    "lord.5.truth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He did not steal the seeds. He was saving them for the very best day. Today was a little cold; tomorrow might be a little better. So the drawers grew to a thousand, and the forest is still only sprouts. He knew that whatever blooms will one day fade."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그는 씨앗을 훔친 게 아니다. 가장 좋은 날에 심으려고 아껴 둔 것이다. 오늘은 조금 춥고, 내일은 조금 더 좋을 것 같았다. 그렇게 서랍이 천 개가 되었고, 숲은 아직 새싹이다. 피어난 것은 언젠가 진다는 것을, 그는 알고 있었다."
          }
        }
      }
    },
    "lord.6.challenger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People with even more to do have come. They mean to dig this mine faster and deeper."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일이 더 많은 사람들이 왔다. 이 굴을 더 빨리, 더 깊이 파겠다고 한다."
          }
        }
      }
    },
    "lord.6.creed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I’m busy. Move. I have thirty-nine things to do. We can talk when they’re done.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“바쁘다. 비켜라. 할 일이 서른아홉 개다. 다 끝나면 그때 이야기하자.”"
          }
        }
      }
    },
    "lord.6.last": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Shine red light on the east wall. There is a half-carved bird. It only needs wings. Who it was for… you find out for me.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“동쪽 벽을 붉은빛으로 비춰 봐라. 깎다 만 새가 한 마리 있다. 날개만 달아 주면 된다. 누구에게 주려 했는지는… 네가 알아내 다오.”"
          }
        }
      }
    },
    "lord.6.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the Restless One"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬지 않는 사람"
          }
        }
      }
    },
    "lord.6.plea": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I can’t stop. If I stop, I’ll remember what I forgot.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“멈추면 안 된다. 멈추면 생각이 난다. 내가 무엇을 잊었는지.”"
          }
        }
      }
    },
    "lord.6.rumor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They say the lord of floor 6 digs day and night to keep every vein, and never shares a single red stone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "6층 주인은 광맥을 혼자 차지하려고 밤낮없이 판다고 한다. 붉은 돌 한 조각도 나눠 주지 않는다고."
          }
        }
      }
    },
    "lord.6.truth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long ago he began digging red stone to carve a gift for someone. If the stone were a little better, a little bigger… so he kept digging. Now thirty-nine tasks are carved on the wall, and he no longer remembers who the gift was for."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아주 오래전 그는 누군가에게 줄 선물을 깎으려고 붉은 돌을 캐기 시작했다. 돌이 조금만 더 좋으면, 조금만 더 크면, 하고 계속 팠다. 이제 벽에는 해야 할 일이 서른아홉 줄 새겨져 있고, 그는 그 선물을 누구에게 주려 했는지 기억하지 못한다."
          }
        }
      }
    },
    "lord.7.challenger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People have come to build the wall higher. Even they do not know what they are afraid of."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽을 더 높이 쌓으려는 사람들이 왔다. 무엇이 무서운지는 그들도 모른다."
          }
        }
      }
    },
    "lord.7.creed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Don’t come closer. I’m not saying you’re bad. I only know that good things can bite too.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“가까이 오지 마라. 네가 나쁘다는 게 아니다. 좋은 것도 물 수 있다는 걸 알 뿐이다.”"
          }
        }
      }
    },
    "lord.7.last": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“When the water falls, don’t clear away all twelve cots. Leave one. Someone hurt may come again.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“물이 내려앉거든 침상 열두 개를 다 치우지는 마라. 하나는 남겨 둬. 누가 또 다쳐서 올지 모르니.”"
          }
        }
      }
    },
    "lord.7.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the Wall-Builder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽을 세운 사람"
          }
        }
      }
    },
    "lord.7.plea": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tear the wall down and someone will come in again. And one day bite me again. …Still, I never broke the habit of setting out two cups.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“벽을 허물면 누가 또 들어오겠지. 그리고 언젠가 또 나를 물겠지. …그래도 찻잔을 두 개 꺼내는 버릇은 못 고쳤다.”"
          }
        }
      }
    },
    "lord.7.rumor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They say the lord of floor 7 is a grump who stood the water up like a wall so nobody can pass."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7층 주인은 물을 벽처럼 세워 아무도 못 지나가게 한 심술쟁이라 한다."
          }
        }
      }
    },
    "lord.7.truth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "She used to take in hurt things and let them sleep: a flier with a torn wing, a lost blob, a crying child. Once, something she took in bit her. From that day she stood the water up. The wall grew higher every year. One by one the healed climbed over it and left, and now she is alone inside."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그녀는 다친 것들을 데려와 재우는 사람이었다. 날개 찢긴 날짐승, 길 잃은 물렁이, 울던 아이. 한 번은 데려온 것이 그녀를 물었다. 그날부터 물을 세웠다. 벽은 해마다 높아졌다. 다 나은 것들은 하나씩 벽을 넘어 떠났고, 이제 벽 안에는 그녀 혼자다."
          }
        }
      }
    },
    "lord.8.challenger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People who find the dark comfortable have come. They want the lights to stay off."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어둠이 편한 사람들이 왔다. 다시는 불을 켜지 말라고 한다."
          }
        }
      }
    },
    "lord.8.creed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“What you can’t see isn’t there. It’s easier to believe that. Try covering your jar.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“보이지 않으면 없는 거다. 그렇게 믿으면 편하다. 너도 병을 가려 봐라.”"
          }
        }
      }
    },
    "lord.8.last": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“If you hear singing in the dark, follow it. Those are the children I looked away from. Now I follow them.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“어둠 속에서 노랫소리가 들리면 따라가라. 내가 외면한 아이들이다. 이제는 내가 그 애들을 따라 걷는다.”"
          }
        }
      }
    },
    "lord.8.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the One with Closed Eyes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈을 감은 사람"
          }
        }
      }
    },
    "lord.8.plea": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Even with my eyes shut, I could hear. If I covered my ears too… would there really be nothing then?”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“눈을 감아도 들리더라. 귀까지 막으면… 그때는 정말 아무것도 없을까.”"
          }
        }
      }
    },
    "lord.8.rumor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They say the torches die on floor 8 because its lord hates light."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8층의 횃불이 꺼지는 것은 그 층 주인이 빛을 미워해서라고 한다."
          }
        }
      }
    },
    "lord.8.truth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floor 8 once had a lantern market. It was bright, and the brighter it was, the more clearly you saw what you did not want to see: a child crying in a corner, people with no money for a lamp. He decided not to see. He put out the lights one by one, and at last he closed his own eyes. In the dark, for the first time, he heard. The crying was still there."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8층에는 한때 등불 시장이 있었다. 시장은 밝았고, 밝은 만큼 보기 싫은 것도 잘 보였다. 구석에서 우는 아이, 등을 살 돈이 없는 사람. 그는 보지 않기로 했다. 불을 하나씩 껐고, 마지막엔 자기 눈을 감았다. 어둠 속에서 그는 처음으로 들었다. 우는 소리는 여전히 거기 있었다."
          }
        }
      }
    },
    "lord.9.challenger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People have come to buy the sky. Your name is in their ledgers now."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘을 사려는 사람들이 왔다. 그들 장부에는 이제 당신 이름이 적혀 있다."
          }
        }
      }
    },
    "lord.9.creed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I bought the sky. It is written in my ledger, and what is written is real. And what do you own?”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“나는 하늘을 샀다. 장부에 적혀 있다. 적혀 있는 건 진짜다. 너는 무엇을 가졌지?”"
          }
        }
      }
    },
    "lord.9.last": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Take it. Owning it doesn’t let you see it. When you are up there… write only one thing in your ledger: who you watched that sky with.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“가져가라. 가진다고 보이는 게 아니더라. 올라가거든… 그 하늘을 누구와 같이 봤는지, 그것만 장부에 적어라.”"
          }
        }
      }
    },
    "lord.9.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the One Who Owns the Sky"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘을 가진 사람"
          }
        }
      }
    },
    "lord.9.plea": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Open the vault and the sky belongs to everyone again. Then I am nobody again.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“창고 문을 열면 하늘은 다시 모두의 것이 된다. 그럼 나는 다시 아무것도 아닌 사람이 된다.”"
          }
        }
      }
    },
    "lord.9.rumor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They say the sky went out because the lord of floor 9 stole it and locked it in a vault."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘이 꺼진 건 9층 주인이 하늘을 훔쳐 창고에 가뒀기 때문이라 한다."
          }
        }
      }
    },
    "lord.9.truth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the city below, children learned this: only what you own is yours. He had never owned anything, so he decided to own the biggest thing. He wrote ‘Sky: mine’ in his ledger, broke the light pillar and brought the sky into his vault. But the vault was dark inside. A sky that is owned shines for no one, not even its owner. What Grandmother put in the jar was the last handful that never went in."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 도시의 아이들은 이렇게 배웠다. 가진 것만 네 것이다. 그는 아무것도 가진 적이 없었다. 그래서 가장 큰 것을 갖기로 했다. 장부에 ‘하늘 — 내 것’이라 적고, 빛기둥을 깨 하늘을 창고에 들였다. 그런데 창고 안은 깜깜했다. 가진 하늘은 아무에게도, 그 자신에게도 빛나지 않았다. 할머니가 병에 담은 빛은 창고에 들어가지 않은 마지막 한 줌이었다."
          }
        }
      }
    },
    "lord.creed.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Grab it before it’s taken. That’s what everyone does once they grow up.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“빼앗기기 전에 쥔다. 어른이 되면 다들 그렇게 한다.”"
          }
        }
      }
    },
    "lord.creed.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“My sister cannot see. Maybe this throne’s light is bright enough for her.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“동생은 앞을 보지 못한다. 이 왕좌의 빛이라면 보일지도 모른다.”"
          }
        }
      }
    },
    "lord.creed.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I count. When I count the tribute, I feel calm.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“나는 센다. 공물이 몇 개인지 세고 있으면 마음이 놓인다.”"
          }
        }
      }
    },
    "lord.creed.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“There is a village whose spring ran dry. Without this tribute they will not see out the long night.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“샘이 마른 마을이 있다. 이 공물이 아니면 그들은 이번 긴 밤을 넘기지 못한다.”"
          }
        }
      }
    },
    "lord.creed.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“When I sit here, everyone looks up at me. That is enough.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“이 자리에 앉으면 다들 나를 올려다본다. 그거면 됐다.”"
          }
        }
      }
    },
    "lord.creed.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Someone once hid me. Now it is my turn to hide others.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“나를 숨겨 준 이들이 있었다. 이번에는 내가 숨겨 줄 차례다.”"
          }
        }
      }
    },
    "lord.creed.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Every promise sent down from above was for tomorrow.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“위에서 내려온 약속은 언제나 내일이었다.”"
          }
        }
      }
    },
    "lord.creed.7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“The throne called me. If you had heard it, you would never have sat there.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“왕좌가 나를 불렀다. 너도 그 소리를 들었다면 앉지 않았을 거다.”"
          }
        }
      }
    },
    "lord.name.0": {
