    "reign.beatenCanClaim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lord of %1$@ has fallen. Press K at the throne to claim it."
          }
        },
        "ko": {
