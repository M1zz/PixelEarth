    "step.0.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press J to look into the jar. Its light (“Jar”, top left) runs down as you use it and fills again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "J를 눌러 병을 들여다보자. 병의 빛(왼쪽 위 ‘병’)은 쓰면 줄고, 채우면 다시 찬다"
          }
        }
      }
    },
    "step.0.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grandmother's jar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할머니의 병"
          }
        }
      }
    },
    "step.1.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As grandmother asked, share light with a neighbour's empty lamp. K at the lamp (Jar 10)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할머니 말대로 이웃의 빈 등불에 빛을 나눠 주자. 등불 앞에서 K (병 10)"
          }
        }
      }
    },
    "step.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light the first house"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫째 집에 빛 나눠 주기"
          }
        }
      }
    },
    "step.2.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the hidden lens with Tab to see a box in the ground. Hold K to dig the soil"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab으로 숨은 것 렌즈를 켜면 땅속 상자가 보인다. K를 길게 눌러 흙을 파자"
          }
        }
      }
    },
    "step.2.title": {
      "extractionState": "manual",
      "localizations": {
