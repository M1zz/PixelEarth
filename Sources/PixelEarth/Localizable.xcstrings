    "ending.lord.stay" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It ended as the Sky-Taker wished. Now, up above, they will call you the one who stole the sky."
