            "value" : "All thrones"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왕좌 목록"
          }
        }
      }
    },
    "lore.creed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their words"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그가 남긴 말"
          }
        }
      }
    },
    "lore.current" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current lord, %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금의 주인, %@"
          }
        }
      }
    },
    "lore.locked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defeat a lord of this floor to learn it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 층의 주인을 쓰러뜨리면 알 수 있다."
          }
        }
      }
    },
    "lore.rumor" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the grown-ups say"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어른들이 하는 말"
          }
        }
      }
    },
    "lore.truth" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the throne remembers"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왕좌가 기억하는 것"
          }
        }
      }
    },
    "lore.you" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You hold this throne now. What will the grown-ups above call you?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 당신이 이 왕좌의 주인이다. 위의 어른들은 당신을 어떻게 부를까."
          }
        }
      }
    },
    "objective.chest.left" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a chest over the hill to the left (%d tiles)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 언덕 너머에 상자가 있다 (%d칸)"
          }
        }
      }
    },
    "objective.chest.right" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is a chest over the hill to the right (%d tiles)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 언덕 너머에 상자가 있다 (%d칸)"
          }
        }
      }
    },
    "objective.defenseBoss" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop the challenger · Throne %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도전자를 막아라 · 왕좌 %@"
          }
        }
      }
    },
    "objective.defensePoints" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Level %1$d · %2$d points · Turrets %3$d/%4$d"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레벨 %1$d · 수비 점수 %2$d · 포탑 %3$d/%4$d"
          }
        }
      }
    },
    "objective.defensePrep" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare %1$ds · Throne %2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
