    "objective.vacant" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empty throne · new lord in %ds"
          }
        },
        "ko" : {
          "stringUnit" : {
