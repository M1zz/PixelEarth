    "passage.5.memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rubble runs on past the door. Three scratches mark the wall, the first deep, the next shallow, the last barely there."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문 너머로 무너진 돌무더기가 이어진다. 벽에 손톱으로 긁은 자국 세 줄이 남아 있다. 처음엔 깊게, 다음엔 얕게, 마지막은 겨우 보일 만큼."
          }
        }
      }
    },
    "passage.5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Side passage: beyond the door"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곁굴 · 문 너머의 통로"
          }
        }
      }
    },
    "passage.6.memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Names cover the wall, thirty-nine of them. The chisel marks grow clumsier toward the end, and the last space is empty."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "벽 가득 이름이 새겨져 있다. 서른아홉 개. 끌 자국이 갈수록 서툴러지다가, 맨 아래 한 칸은 비어 있다."
          }
        }
      }
    },
    "passage.6.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Side passage: the east wall"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곁굴 · 동쪽 벽"
          }
        }
      }
    },
    "passage.7.memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twelve small cots stand by the water, each with a bundle of dried herbs at its head. They are still warm."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "물가에 작은 침상 열두 개가 놓여 있다. 머리맡마다 마른 약초가 한 묶음씩 걸려 있고, 침상은 아직 따뜻하다."
          }
        }
      }
    },
    "passage.7.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Side passage: the house past the veil"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곁굴 · 장막 너머의 집"
          }
        }
      }
    },
    "passage.8.memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a dark without a single lamp, children are singing. The song follows the wall further in."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "등불 하나 없는 어둠 속에서 아이들 노랫소리가 들린다. 노래는 벽을 따라 더 깊은 곳으로 이어진다."
          }
        }
      }
    },
    "passage.8.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Side passage: the singing dark"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곁굴 · 노래하는 어둠"
          }
        }
      }
    },
    "passage.9.memory" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ceiling is painted with a sky of blue stone dust. One cloud is still wet, and under it is a small handprint."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "천장 가득 푸른 돌가루로 하늘이 칠해져 있다. 구름 하나는 덜 마른 채이고, 그 아래 작은 손자국이 찍혀 있다."
          }
        }
      }
    },
