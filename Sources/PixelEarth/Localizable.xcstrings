    "reign.claimNames" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The names of every lord before are carved into the throne. Yours is now the last."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왕좌 등받이에 이전 주인들의 이름이 새겨져 있다. 이제 그 끝에 당신의 이름이 있다."
          }
        }
      }
    },
    "reign.claimed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are now lord %1$d of %2$@. Tribute will gather; when challenged, you must defend the throne."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신은 이제 %2$@의 제%1$d대 주인이다. 공물이 쌓이고, 도전이 오면 왕좌를 지켜야 한다."
          }
        }
      }
    },
