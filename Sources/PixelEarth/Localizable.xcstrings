          }
        }
      }
    },
    "lore.locked" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defeat a lord of this floor to learn it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 층의 주인을 쓰러뜨리면 알 수 있다."
          }
        }
      }
    },
    "lore.rumor" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the world says"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세상이 하는 말"
          }
        }
      }
    },
    "lore.truth" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the throne remembers"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왕좌가 기억하는 것"
          }
        }
      }
    },
    "lore.you" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You hold this throne now. What do they call you up above?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 당신이 이 왕좌의 주인이다. 위에서는 당신을 어떻게 부를까."
          }
        }
      }
    },
    "objective.chest.left" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
