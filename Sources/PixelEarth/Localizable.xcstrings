    "defense.turretMax": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more turrets can be placed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포탑은 더 놓을 수 없다."
          }
        }
      }
    },
    "defense.wave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wave %1$d of %2$d!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d/%2$d 파도가 몰려온다!"
          }
        }
      }
    },
    "dig.hard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard stratum. Not even a pickaxe moves it. Look for a cracked vein."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "굳은 지층이다. 곡괭이로도 꿈쩍하지 않는다. 금이 간 길을 찾자."
          }
        }
      }
    },
    "dig.needLight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The light must grow first. Raise the jar to a lantern."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛이 더 자라야 한다. 병을 등불만큼 키우자."
          }
        }
      }
    },
    "dig.needPick": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare hands only move soil and sand. You need a pickaxe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맨손으로는 흙과 모래만 판다. 곡괭이가 필요하다."
          }
        }
      }
    },
    "dig.never": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be broken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부술 수 없다."
          }
        }
      }
    },
    "dig.rubble": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapsed rock. It cannot be broken yet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무너진 암석이다. 아직은 뚫을 수 없다."
          }
        }
      }
    },
