    "td.sealed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cracked rock seals the stairs. Dig it with a pickaxe"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계단이 갈라진 바위에 막혀 있다. 곡괭이로 파자"
          }
        }
      }
    },
    "td.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nael — the Jar of Light"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나엘 — 빛을 담은 병"
          }
        }
      }
    },
    "td.upperLine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The surface is still close. The child’s footprints lead further down."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 위가 가깝다. 아이의 발자국이 더 아래로 이어진다."
          }
        }
      }
    },
    "td.upperName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shallow caves"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얕은 굴"
          }
        }
      }
    },
    "td.useLens": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find them with the path lens (Tab)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길 렌즈(Tab)로 찾자"
          }
        }
      }
    },
    "turn.notNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot leave while defending the throne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왕좌를 지키는 중에는 자리를 뜰 수 없다."
          }
        }
      }
    },
    "tutorial.finished": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The afternoon is yours. Take a look around."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오후가 온전히 당신 것이다. 천천히 둘러보자."
          }
        }
      }
    },
    "tutorial.tremor1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ground trembles faintly."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발밑이 희미하게 떨린다."
          }
        }
      }
    },
    "tutorial.tremor2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The skymist flickers. The light in the jar leans downward."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛안개가 깜빡인다. 병 속 빛이 아래로 기운다."
          }
        }
      }
    },
    "td.attack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attack"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공격"
          }
        }
      }
    },
    "td.dodge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
