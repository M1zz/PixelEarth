          "stringUnit": {
            "state": "translated",
            "value": "Find grandmother's box"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할머니의 상자 찾기"
          }
        }
      }
    },
    "step.3.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the green spore with a number key and press F. What goes in colours the light and fills it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초록 포자를 숫자 키로 들고 F. 병에 넣은 것이 빛의 색을 바꾸고 빛을 채운다"
          }
        }
      }
    },
    "step.3.title": {
