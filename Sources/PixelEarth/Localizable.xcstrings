    "cover.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cover the jar. What follows light loses you. You can barely see."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병을 가렸다. 빛을 쫓는 것들이 당신을 놓친다. 당신도 거의 보지 못한다."
          }
        }
      }
    },
    "defense.fell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You fell. The throne took heavy damage."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰러졌다. 왕좌가 크게 상했다."
          }
        }
      }
    },
    "defense.needPoints": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs %d points. Defeat attackers to earn them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수비 점수 %d점이 필요하다. 적을 쓰러뜨려 모으자."
          }
        }
      }
    },
    "defense.noRoom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No room to build here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에는 지을 수 없다."
          }
        }
      }
    },
    "defense.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defend! Level %1$d (%2$@) · %3$ds to prepare · B turret, V wall"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수비 시작! 레벨 %1$d (%2$@) · 준비 %3$d초 · B 포탑, V 방벽"
          }
        }
      }
    },
