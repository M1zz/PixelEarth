          "stringUnit": {
            "state": "translated",
            "value": "빛안개가 땅속으로 빨려 들어간다. 할머니가 서 있던 자리에 계단 같은 틈이 열렸다. 아이를 찾아 내려가자."
          }
        }
      }
    },
    "td.fell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You fell. You wake beside the stairs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰러졌다. 계단 곁에서 다시 일어난다."
          }
        }
      }
    },
    "td.findStairs": {
