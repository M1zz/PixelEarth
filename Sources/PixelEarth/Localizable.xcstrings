            "value": "Roll"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구르기"
          }
        }
      }
    },
    "td.enemy.slime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slime"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점액"
          }
        }
      }
    },
    "td.enemy.bat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bat"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "박쥐"
          }
        }
      }
    },
    "td.enemy.starved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Starved"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛굶주린 자"
          }
        }
      }
    },
    "td.enemy.lord": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floor Lord"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "층 주인"
          }
        }
      }
    },
    "td.cache.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words cut in the wall, in grandmother's hand: “I know the way this far. From here on, I leave a light behind.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 새긴 글씨, 할머니의 손이다. “여기까지는 길을 안다. 여기부터는 불을 두고 간다.”"
          }
        }
      }
    },
    "td.cache.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words cut in the wall, in grandmother's hand: “A man who sells shiny things offered to buy my jar. I did not sell.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 새긴 글씨, 할머니의 손이다. “반짝이는 것을 파는 사람이 병을 사겠다고 했다. 팔지 않았다.”"
          }
        }
      }
    },
    "td.cache.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words cut in the wall, in grandmother's hand: “The line is long. No one knows what it waits for. I stood in it, then stepped out.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 새긴 글씨, 할머니의 손이다. “줄이 길다. 무얼 기다리는지 아무도 모른다. 나도 섰다가 나왔다.”"
          }
        }
      }
    },
    "td.cache.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words cut in the wall, in grandmother's hand: “Every wall curses the people below. Whoever wrote it never went down.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 새긴 글씨, 할머니의 손이다. “벽마다 아래 사람들 욕이 적혀 있다. 쓴 사람은 내려가 본 적이 없다.”"
          }
        }
      }
    },
    "td.cache.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words cut in the wall, in grandmother's hand: “A man of many drawers gave me a seed to plant tomorrow. I planted it today.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 새긴 글씨, 할머니의 손이다. “서랍이 많은 사람. 씨앗 하나를 주며 내일 심으라더라. 오늘 심었다.”"
          }
        }
      }
    },
    "td.cache.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words cut in the wall, in grandmother's hand: “I asked the one who never rests who the gift was for. He could not answer.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 새긴 글씨, 할머니의 손이다. “쉬지 않는 사람에게 누구 선물이냐고 물었다. 대답을 못 했다.”"
          }
        }
      }
    },
    "td.cache.7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words cut in the wall, in grandmother's hand: “She gave me tea. When I finished she put the second cup away. I was sorry.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 새긴 글씨, 할머니의 손이다. “찻잔을 내주었다. 마시고 나니 하나를 도로 치웠다. 미안했다.”"
          }
        }
      }
    },
    "td.cache.8": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words cut in the wall, in grandmother's hand: “Here you hear only with the jar covered. Someone crying. I sat a long while.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 새긴 글씨, 할머니의 손이다. “여기선 병을 가려야 들린다. 우는 소리. 오래 앉아 있었다.”"
          }
        }
      }
    },
    "td.cache.9": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words cut in the wall, in grandmother's hand: “The door. If I open it, it may become mine, so I turn back. Whoever comes: do not open it alone.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 새긴 글씨, 할머니의 손이다. “문 앞이다. 열면 내 것이 될까 봐 돌아간다. 누가 오거든 혼자 열지 마라.”"
          }
        }
      }
    },
    "td.lore.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“The mist is thin today. Thicker tomorrow, surely.” An undated note."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“오늘 안개가 얇다. 내일은 두껍겠지.” 날짜가 없는 쪽지."
          }
        }
      }
    },
    "td.lore.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A child's writing: “Mom's light-pouch is the brightest.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 글씨: “엄마 빛주머니가 제일 밝다.”"
          }
        }
      }
    },
    "td.lore.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“The Council keeps the light. No private keeping.” A torn notice."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“빛은 의회가 지킨다. 개인 보관 금지.” 찢긴 공고문."
          }
        }
      }
    },
    "td.lore.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A miner's tally: coal twelve, iron three, and “a handful of sky — not for sale”."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광부의 셈: 석탄 열둘, 철 셋, 그리고 “하늘 한 줌—못 팜”."
          }
        }
      }
    },
    "td.lore.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Rest here. Don't put out the fire.” Someone left these words."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“여기서 쉬어 가요. 불은 끄지 말고.” 누군가 남긴 말."
          }
        }
      }
    },
    "td.lore.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name is scratched on an old jar. Worn away, unreadable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병 하나에 이름이 긁혀 있다. 지워져서 읽을 수 없다."
          }
        }
      }
    },
    "td.lore.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“I heard the rumors up there. Down here, it was only a person.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“위에서 소문을 들었다. 내려와 보니 그냥 사람이었다.”"
          }
        }
      }
    },
    "td.lore.7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small drawing: people holding hands under a huge sky."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 그림: 커다란 하늘 아래 손잡은 사람들."
          }
        }
      }
    },
    "td.lore.rare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rare spore. Fed to the jar, it may change the color of its light."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀한 포자다. 병에 넣으면 빛의 색이 바뀔 것 같다."
          }
        }
      }
    },
    "td.oldTorch.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone lit this. Teal, the same light as grandmother's jar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누가 켜 둔 불이다. 청록빛, 할머니 병과 같은 빛."
          }
        }
      }
    },
    "td.clue.sound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somewhere behind the rock, water is dripping."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽 너머에서 물방울 떨어지는 소리가 난다."
          }
        }
      }
    },
    "td.clue.tool": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dropped pickaxe. Its blade points at a wall of earth."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누가 떨어뜨린 곡괭이. 날이 흙벽을 향해 있다."
          }
        }
      }
    },
    "td.clue.hollow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It sounds different. Hollow inside."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리가 다르다. 속이 빈 것 같다."
          }
        }
      }
    },
    "td.torch.cant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't set a torch here"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기엔 횃불을 놓을 수 없다"
          }
        }
      }
    },
    "td.torch.first": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A set torch keeps burning. Light the way you'll come back. With no torches, it takes from the jar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "놓은 횃불은 계속 탄다. 다시 올 길을 밝혀 두자. 횃불이 없으면 병의 빛을 덜어 쓴다"
          }
        }
      }
    },
    "td.truth.5.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three tally marks counting days on the wall. The first deep, the last barely there. Nothing after."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 날짜를 세던 금 세 줄. 처음엔 깊게, 마지막은 겨우 보일 만큼. 그 뒤로는 없다."
          }
        }
      }
    },
    "td.truth.5.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small drawer buried in the earth, full of seeds. Every label says ‘tomorrow’."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흙에 묻힌 작은 서랍. 씨앗이 가득하다. 이름표마다 ‘내일’이라고 적혀 있다."
          }
        }
      }
    },
    "td.truth.5.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprouts that never bloomed, though someone watered them faithfully. What blooms must fade, so he never let them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피지 않은 새싹들. 물은 꼬박꼬박 준 자국이 있다. 피면 언젠가 지니까, 피우지 않은 것이다."
          }
        }
      }
    },
    "td.truth.6.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A red stone bird with no wings. Carved with care, then left unfinished."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날개 없는 붉은 돌 새. 정성껏 깎다 말았다."
          }
        }
      }
    },
    "td.truth.6.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thirty-nine tasks carved in a row. Only the last is not crossed out: ‘Give the bird to ○○.’"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 서른아홉 줄. 맨 아래 한 줄만 지워지지 않았다. ‘○○에게 새를 주기.’"
          }
        }
      }
    },
    "td.truth.6.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozens of worn-out pickaxe handles, piled up. Not a single chair to rest on."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닳은 곡괭이 자루가 수십 개 쌓여 있다. 쉬는 의자는 하나도 없다."
          }
        }
      }
    },
    "td.truth.7.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twelve empty beds, dried herbs at every head. All of them clean."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 침상 열두 개. 머리맡마다 마른 약초. 모두 깨끗하다."
          }
        }
      }
    },
    "td.truth.7.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two teacups. One shines as if never used."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찻잔 두 개. 하나는 한 번도 쓰지 않은 것처럼 반짝인다."
          }
        }
      }
    },
    "td.truth.7.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An old glove with a bite mark. Still, she kept it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물린 자국이 남은 낡은 장갑. 그래도 버리지 않았다."
          }
        }
      }
    },
    "td.truth.8.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hundreds of broken lanterns. Every one was put out by hand."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨진 등불 수백 개. 하나같이 손으로 직접 끈 자국이 있다."
          }
        }
      }
    },
    "td.truth.8.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small blanket in a corner, as if someone meant to cover a child with it, and stopped."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구석에 작은 담요. 누군가 아이에게 덮어 주려다 만 것 같다."
          }
        }
      }
    },
    "td.truth.8.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ear to the wall, you hear singing. Children's voices, leading deeper."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 귀를 대니 노랫소리가 들린다. 아이들 목소리다. 더 깊은 곳으로 이어진다."
          }
        }
      }
    },
    "td.truth.9.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A thick ledger. On the last page: ‘Sky — mine.’ Erased and rewritten many times."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두꺼운 장부. 마지막 장에 ‘하늘 — 내 것’. 그 위에 지운 자국이 여러 번."
          }
        }
      }
    },
    "td.truth.9.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light-mist painted on the ceiling by children: ‘our sky’. ‘Our’ was erased and written again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천장에 아이들이 칠한 빛안개. ‘우리 하늘’. ‘우리’는 지웠다 다시 쓴 자국이다."
          }
        }
      }
    },
    "td.truth.9.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An old school slate: ‘Only what you own is yours.’"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘가진 것만 네 것이다’라고 적힌 낡은 학교 칠판."
          }
        }
      }
    },
    "td.call.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“You didn't steal the seeds. You were waiting for a good day. Today is a good day too.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“씨앗을 훔친 게 아니잖아요. 좋은 날을 기다린 거죠. 오늘도 좋은 날이에요.”"
          }
        }
      }
    },
    "td.call.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Who was the bird for? Rest a moment. Let's remember together.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“그 새, 누구 주려던 거예요? 잠깐 쉬면서 같이 기억해 봐요.”"
          }
        }
      }
    },
    "td.call.7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“You were bitten, so you were afraid. But you still set out two cups. I'll sit.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“물려서 무서웠던 거죠. 그래도 찻잔은 두 개 꺼내잖아요. 제가 앉을게요.”"
          }
        }
      }
    },
    "td.call.8": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“You heard them even with your eyes shut. Let's look together this time. I'll be beside you.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“눈 감아도 들렸잖아요. 이번엔 같이 봐요. 제가 옆에 있을게요.”"
          }
        }
      }
    },
    "td.call.9": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“A sky you own shines for no one. Shared, it shines. It's our sky.”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“가진 하늘은 아무에게도 안 빛나요. 같이 보면 빛나요. 우리 하늘이잖아요.”"
          }
        }
      }
    },
    "td.yield": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lowers their hands. The fight is over."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이 손을 내린다. 싸움이 멈췄다."
          }
        }
      }
    },
    "td.truthCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you know of %1$@: %2$d/3"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 대해 아는 것: %2$d/3"
          }
        }
      }
    },
    "td.truthAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You know all of %@'s story. When you meet, it may end without a fight."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 이야기를 모두 알았다. 마주치면 싸우지 않고 끝낼 수 있을지도 모른다."
          }
        }
      }
    },
    "td.truthPartial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s true story is still half-told. (%2$d/3)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 진짜 이야기는 아직 반쪽이다. (%2$d/3)"
          }
        }
      }
    },
    "td.truthProgress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Truths %d/3"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진실 %d/3"
          }
        }
      }
    },
    "td.graffiti": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scratched on the wall: “%@”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽에 누가 긁어 쓴 낙서. “%@”"
          }
        }
      }
    },
    "td.gate.G": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the green light, the roots slowly draw back."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초록빛이 닿자 뿌리가 스르르 물러난다."
          }
        }
      }
    },
    "td.gate.R": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the red light the hard rock splits. Now it can be dug."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붉은빛에 굳은 바위가 쩍 갈라진다. 이제 캘 수 있다."
          }
        }
      }
    },
    "td.gate.B": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under the blue light, the standing water steps aside."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "푸른빛 아래 서 있던 물이 길을 비킨다."
          }
        }
      }
    },
    "td.gate.C": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the jar covered, a darkness you took for a wall moves aside."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병을 가리자, 벽인 줄 알았던 어둠이 비켜선다."
          }
        }
      }
    },
    "td.camp.arrive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fire still burns here. Someone rested in this place. Nothing comes near the fire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모닥불이 꺼지지 않고 남아 있다. 누군가 여기서 쉬어 갔다. 불 곁에는 아무것도 다가오지 않는다."
          }
        }
      }
    },
    "td.camp.whole": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole camp is awake. Now down, to the end."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캠프가 모두 깨어났다. 이제 아래로, 끝까지."
          }
        }
      }
    },
    "td.altar.R.need": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sleeping altar. Your jar needs red light to wake it (jar 15)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠든 제단. 병에 붉은 빛이 있어야 깨울 수 있다 (병 15)"
          }
        }
      }
    },
    "td.altar.R.lit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The forge wakes. Someone returns and lifts a hammer. (Attack +6)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대장간이 깨어났다. 누군가 돌아와 망치를 든다. (공격 +6)"
          }
        }
      }
    },
    "td.altar.G.need": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sleeping altar. Your jar needs green light to wake it (jar 15)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠든 제단. 병에 초록 빛이 있어야 깨울 수 있다 (병 15)"
          }
        }
      }
    },
    "td.altar.G.lit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The greenhouse wakes. Someone returns to tend the light-plants. (The jar refills at camp)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온실이 깨어났다. 누군가 돌아와 빛풀을 돌본다. (캠프에서 병이 차오른다)"
          }
        }
      }
    },
    "td.altar.B.need": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sleeping altar. Your jar needs blue light to wake it (jar 15)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠든 제단. 병에 푸른 빛이 있어야 깨울 수 있다 (병 15)"
          }
        }
      }
    },
    "td.altar.B.lit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The well wakes. Someone returns to draw water. (Max light +20)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우물이 깨어났다. 누군가 돌아와 물을 긷는다. (최대 빛 +20)"
          }
        }
      }
    }
  },
  "version": "1.0"
}