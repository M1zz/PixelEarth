    "objective.descend" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go down into the crack"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갈라진 땅으로 내려가자"
          }
        }
      }
    },
    "objective.descend.here" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
