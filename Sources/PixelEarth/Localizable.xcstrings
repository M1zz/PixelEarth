    "ending.lord.stay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky stays below. Now the grown-ups above will write your name in their ledgers: the one who owns the sky."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘은 아래에 남았다. 이제 위의 어른들은 장부에 당신 이름을 적을 것이다. 하늘을 가진 사람이라고."
          }
        }
      }
    },
    "ending.lord.up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault is open. For the first time he closes his ledger and looks up. He writes nothing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창고 문이 열렸다. 그는 처음으로 장부를 덮고 하늘을 올려다본다. 아무것도 적지 않는다."
          }
        }
      }
    },
    "energy.gain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jar +%d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병 +%d"
          }
        }
      }
    },
    "energy.hud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jar %1$d/%2$d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병 %1$d/%2$d"
          }
        }
      }
    },
    "energy.lensOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The jar has run dry; the lens goes out."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병의 빛이 다해 렌즈가 꺼졌다."
          }
        }
      }
    },
    "energy.low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The jar is running low. Fill it at a light spring (K), by feeding spores or ore (F), or at the woken camp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병의 빛이 얼마 남지 않았다. 빛샘(K), 포자나 광석 먹이기(F), 깨어난 캠프에서 채울 수 있다."
          }
        }
      }
    },
    "energy.notEnough": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough light in the jar. It needs %d."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병의 빛이 모자란다. 병 %d이 필요하다."
          }
        }
      }
    },
    "errand.childMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The child of this house is gone. The footprints vanish down the crack. Then the ground shakes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 집 아이가 없다. 발자국은 틈 아래로 사라졌다. 그때 발밑이 울린다."
          }
        }
      }
    },
