    "intro.jar" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiet afternoon. Grandmother hands you a small jar with a light breathing inside. “Don’t let it go out.”"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조용한 오후. 할머니가 작은 병을 건넸다. 안에서 빛이 숨 쉬고 있다. “꺼뜨리지 마라.”"
          }
        }
      }
    },
