    "ending.lord.stay" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sky stays below. Now the grown-ups above will write your name in their ledgers: the one who owns the sky."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하늘은 아래에 남았다. 이제 위의 어른들은 장부에 당신 이름을 적을 것이다. 하늘을 가진 사람이라고."
          }
        }
      }
    },
    "ending.lord.up" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The vault is open. For the first time he closes his ledger and looks up. He writes nothing."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창고 문이 열렸다. 그는 처음으로 장부를 덮고 하늘을 올려다본다. 아무것도 적지 않는다."
          }
        }
      }
    },
